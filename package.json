{
  "name": "shopeasy-automation",
  "version": "1.0.0",
  "description": "Playwright end-to-end automation for SauceDemo",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --forbid-only",
    "test:chrome": "playwright test --project=chrome",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/mcp": "^0.0.86",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.22.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "^18.0.9"
  }
}
